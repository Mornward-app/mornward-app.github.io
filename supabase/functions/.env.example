# Secrets for Supabase Edge Functions. Copy to supabase/functions/.env for local testing only;
# .env is ignored by git. For the deployed functions, set it once with:
#   supabase secrets set GEMINI_API_KEY=your-key
# Inside a function, read it on the server side, e.g. Deno.env.get("GEMINI_API_KEY").
# Never put this key in index.html or anything under the site root: the whole site is public.
GEMINI_API_KEY=
