{
  "id": "./",
  "name": "Mornward",
  "short_name": "Mornward",
  "description": "Before the scroll, a few mini tasks. Three breaths, then up to three small things for this morning. About one minute.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDF5FC",
  "theme_color": "#EDF5FC",
